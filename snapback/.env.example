# Copy this file to .env.local and fill in the two values from Supabase.
# In Vercel these same two go in Settings → Environment Variables instead.
#
# Both are meant to be public — they are compiled into the page the browser
# downloads. The anon key is not a password; what it can do is decided by the
# policies in supabase/schema.sql.

VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...
